# Copie para .env.local e preencha.

# PostgreSQL local (a base de dados é criada por `npm run db:setup`)
DATABASE_URL=postgres://postgres:SUA_PASSWORD@localhost:5432/portfolio

# true = o TypeORM ajusta as tabelas automaticamente ao arrancar (útil em dev)
DB_SYNCHRONIZE=true

# Segredo para assinar a sessão do painel (mín. 32 caracteres).
# Gerar: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Conta de administrador criada por `npm run db:setup`
ADMIN_NAME=Joel Silva
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Opcional: pasta onde ficam os uploads (por omissão ./storage/uploads)
# UPLOAD_DIR=

# URL público do site (usado nas imagens Open Graph e links canónicos)
NEXT_PUBLIC_SITE_URL=https://joelsilva.site
